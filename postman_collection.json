{
  "info": {
    "name": "Gallery API - Seed Data",
    "_postman_id": "gallery-seed-collection",
    "description": "Collection to create sample artists, customers, artworks and orders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3007"
    }
  ],
  "item": [
    {
      "name": "Create Artist",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Frida\",\n  \"last_name\": \"Kahlo\",\n  \"birth_year\": 1907\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/artists/",
          "host": ["{{baseUrl}}"],
          "path": ["artists", ""]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.artist_id) { pm.environment.set('artist_id', json.artist_id); }",
              "pm.test('created artist', function() { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Ruth\",\n  \"last_name\": \"Cohen\",\n  \"email\": \"ruth@example.com\",\n  \"phone\": \"052-1234567\",\n  \"address\": \"Jerusalem\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/customers/",
          "host": ["{{baseUrl}}"],
          "path": ["customers", ""]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.customer_id) { pm.environment.set('customer_id', json.customer_id); }",
              "pm.test('created customer', function() { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Artwork",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"The Two Fridas\",\n  \"description\": \"Self-portrait by Frida Kahlo\",\n  \"year_created\": 1939,\n  \"price\": 150000.0,\n  \"id_artist\": \"{{artist_id}}\",\n  \"art_type\": \"painting\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/artworks/",
          "host": ["{{baseUrl}}"],
          "path": ["artworks", ""]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.id_artwork) { pm.environment.set('artwork_id', json.id_artwork); }",
              "pm.test('created artwork', function() { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_customer\": \"{{customer_id}}\",\n  \"order_date\": \"2026-01-12\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders/",
          "host": ["{{baseUrl}}"],
          "path": ["orders", ""]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.id_order) { pm.environment.set('order_id', json.id_order); }",
              "pm.test('created order', function() { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Add Artwork To Order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_order\": \"{{order_id}}\",\n  \"id_artwork\": \"{{artwork_id}}\",\n  \"amount\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/artworks_in_order/",
          "host": ["{{baseUrl}}"],
          "path": ["artworks_in_order", ""]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.id_artwork_in_order) { pm.environment.set('artwork_in_order_id', json.id_artwork_in_order); }",
              "pm.test('added artwork to order', function() { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    }
  ]
}
